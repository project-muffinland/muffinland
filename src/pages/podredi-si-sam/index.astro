---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllMuffinSets } from "../../lib/sanity";

const sets = (await getAllMuffinSets()) || [];
---

<BaseLayout>
  <section class="sets">
    <div class="wrap">
      <span class="eyebrow">Muffin Land</span>
      <h1>Подреди си сам</h1>
      <p class="sets__intro">
        Избери колекция и си подреди кутията – 24 от един вид, 12 + 12 или
        каквато комбинация ти хареса.
      </p>

      {sets.length === 0 && <p>Скоро ще добавим нови колекции.</p>}

      {
        sets.map((set: any, setIndex: number) => (
          <div class="set">
            <div class="set__head">
              <h2>{set.title}</h2>
              <hr class="set__line" />
              {set.baseDescription && (
                <p class="set__desc">{set.baseDescription}</p>
              )}
            </div>

            <div class="set__grid">
              {set.muffins?.map((m: any) => (
                <figure class="set__item">
                  <button
                    type="button"
                    class="set__item-btn"
                    data-set={setIndex}
                    data-src={m.imageUrl || "https://via.placeholder.com/800x800"}
                    data-title={m.title}
                    data-desc={m.description || ""}
                    data-set-title={set.title}
                    data-href={`/podredi-si-sam/${set.slug}`}
                    aria-label={`Виж снимката: ${m.title}`}
                  >
                    <img
                      src={m.imageUrl || "https://via.placeholder.com/400x400"}
                      alt={m.title}
                      loading="lazy"
                    />
                  </button>
                  <figcaption>{m.title}</figcaption>
                </figure>
              ))}
            </div>

            <a href={`/podredi-si-sam/${set.slug}`} class="btn btn-solid set__cta">
              Подреди кутия от „{set.title}“
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Снимка на мъфин">
    <button type="button" class="lightbox__close" id="lb-close" aria-label="Затвори">&times;</button>
    <button type="button" class="lightbox__nav lightbox__prev" id="lb-prev" aria-label="Предишна">&#8249;</button>
    <figure class="lightbox__figure">
      <img id="lb-img" src="" alt="" />
      <figcaption>
        <strong id="lb-title"></strong>
        <span id="lb-desc"></span>
      </figcaption>
      <a id="lb-cta" href="#" class="btn btn-solid lightbox__cta"></a>
    </figure>
    <button type="button" class="lightbox__nav lightbox__next" id="lb-next" aria-label="Следваща">&#8250;</button>
  </div>
</BaseLayout>

<script>
  const lightbox = document.getElementById("lightbox") as HTMLElement;
  const lbImg = document.getElementById("lb-img") as HTMLImageElement;
  const lbTitle = document.getElementById("lb-title") as HTMLElement;
  const lbDesc = document.getElementById("lb-desc") as HTMLElement;
  const lbPrev = document.getElementById("lb-prev") as HTMLButtonElement;
  const lbNext = document.getElementById("lb-next") as HTMLButtonElement;
  const lbClose = document.getElementById("lb-close") as HTMLButtonElement;
  const lbCta = document.getElementById("lb-cta") as HTMLAnchorElement;

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".set__item-btn"));
  let group: HTMLButtonElement[] = [];
  let current = 0;
  let lastFocused: HTMLElement | null = null;

  function show(i: number) {
    current = (i + group.length) % group.length;
    const b = group[current];
    lbImg.src = b.dataset.src || "";
    lbImg.alt = b.dataset.title || "";
    lbTitle.textContent = b.dataset.title || "";
    lbDesc.textContent = b.dataset.desc || "";
    lbCta.href = b.dataset.href || "#";
    lbCta.textContent = `Подреди кутия от „${b.dataset.setTitle || ""}“`;
    const single = group.length < 2;
    lbPrev.hidden = single;
    lbNext.hidden = single;
  }

  function open(btn: HTMLButtonElement) {
    // листваме само снимките от същата колекция И от същия ред в галерията
    const top = btn.getBoundingClientRect().top;
    group = buttons.filter(
      (b) => b.dataset.set === btn.dataset.set && Math.abs(b.getBoundingClientRect().top - top) < 5
    );
    lastFocused = btn;
    show(group.indexOf(btn));
    lightbox.hidden = false;
    document.body.style.overflow = "hidden";
    lbClose.focus();
  }

  function close() {
    lightbox.hidden = true;
    document.body.style.overflow = "";
    lbImg.src = "";
    lastFocused?.focus();
  }

  buttons.forEach((b) => b.addEventListener("click", () => open(b)));
  lbClose.addEventListener("click", close);
  lbPrev.addEventListener("click", () => show(current - 1));
  lbNext.addEventListener("click", () => show(current + 1));

  // клик върху тъмния фон затваря
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener("keydown", (e) => {
    if (lightbox.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });
</script>

<style>
  .sets {
    padding: 64px 0 80px;
  }
  .sets h1 {
    font-size: 2.4rem;
    line-height: 1.1;
    margin: 6px 0 12px;
  }
  .sets__intro {
    color: var(--color-text-soft);
    margin: 0 0 48px;
    max-width: 620px;
  }

  .set {
    margin-bottom: 64px;
  }
  .set__head h2 {
    font-size: 1.6rem;
    margin: 0 0 12px;
  }
  .set__line {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 0 12px;
  }
  .set__desc {
    color: var(--color-text-soft);
    margin: 0 0 20px;
  }

  .set__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }
  .set__item {
    margin: 0;
  }
  .set__item-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: 16px;
  }
  .set__item img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 16px;
    display: block;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .set__item-btn:hover img,
  .set__item-btn:focus-visible img {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }
  .set__item figcaption {
    margin-top: 8px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    text-align: center;
  }
  .set__cta {
    display: inline-block;
  }

  /* --- Lightbox --- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__figure {
    margin: 0;
    max-width: min(90vw, 900px);
    text-align: center;
    color: #fff;
  }
  .lightbox__figure img {
    max-width: 100%;
    max-height: 78vh;
    border-radius: 14px;
    object-fit: contain;
    background: #111;
  }
  .lightbox__figure figcaption {
    margin-top: 12px;
    font-family: var(--font-sans);
  }
  .lightbox__figure strong {
    display: block;
    font-size: 1.1rem;
  }
  .lightbox__figure span {
    display: block;
    margin-top: 4px;
    font-size: 0.9rem;
    color: #cfcfcf;
  }
  .lightbox__cta {
    display: inline-block;
    margin-top: 16px;
  }
  .lightbox__close,
  .lightbox__nav {
    background: rgba(255, 255, 255, 0.15);
    border: none;
    color: #fff;
    cursor: pointer;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.8rem;
    line-height: 1;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }
  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .lightbox__close {
    position: absolute;
    top: 16px;
    right: 16px;
  }
  .lightbox__nav[hidden] {
    display: none;
  }

  @media (max-width: 600px) {
    .lightbox {
      padding: 12px;
      gap: 6px;
    }
    .lightbox__nav {
      width: 36px;
      height: 36px;
      font-size: 1.5rem;
    }
  }
</style>