---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomepage } from "../lib/sanity";

const homepage = await getHomepage();
const bestSellers = homepage?.bestSellers ?? [];
const gallery = homepage?.gallery ?? [];
const heroImageUrl = homepage?.heroImageUrl ?? null;
const PREVIEW_COUNT = 6; // shown on the page: 6 (desktop/tablet/large phones); CSS trims to 4 on very small phones
const previewImages = gallery.slice(0, PREVIEW_COUNT);
const hasMore = gallery.length > 4;
const moreOnAllScreens = gallery.length > PREVIEW_COUNT;

// Static placeholder data — replace with your own content source.
const muffins = [
  {
    _id: "1",
    name: "Боровинково блаженство",
    slug: "blueberry-bliss",
    imageUrl: "https://picsum.photos/seed/muffin1/500/500",
  },
  {
    _id: "2",
    name: "Двоен шоколад",
    slug: "double-chocolate",
    imageUrl: "https://picsum.photos/seed/muffin2/500/500",
  },
  {
    _id: "3",
    name: "Солен карамел с хрупкава поръска",
    slug: "salted-caramel-crumble",
    imageUrl: "https://picsum.photos/seed/muffin3/500/500",
  },
  {
    _id: "4",
    name: "Банан и орех",
    slug: "banana-walnut",
    imageUrl: "https://picsum.photos/seed/muffin4/500/500",
  },
  {
    _id: "5",
    name: "Лимон и маково семе",
    slug: "lemon-poppyseed",
    imageUrl: "https://picsum.photos/seed/muffin5/500/500",
  },
  {
    _id: "6",
    name: "Канелен щройзел",
    slug: "cinnamon-streusel",
    imageUrl: "https://picsum.photos/seed/muffin6/500/500",
  },
];

const heroImageAlt = "Прясно изпечен мъфин в рустикална хартиена опаковка";

const icons: Record<string, string> = {
  heart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
  leaf: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
  whisk: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/></svg>`,
  gift: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>`,
  truck: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>`,
};

const features = [
  {
    icon: "heart",
    title: "Направено с любов",
    copy: "Всеки мъфин е изпечен с грижа.",
  },
  {
    icon: "leaf",
    title: "Качествени съставки",
    copy: "Използваме прости, първокласни съставки.",
  },
  {
    icon: "whisk",
    title: "Ръчна изработка",
    copy: "Малки партиди. Голям вкус.",
  },
  {
    icon: "gift",
    title: "Идеално за",
    copy: "Рождени дни, празненства или просто така.",
  },
  {
    icon: "truck",
    title: "Прясна доставка", 
    copy: "Вкусотия, доставена до вас.",
  },
];

const testimonials = [
  {
    quote: "Най-накрая, мъфин, който подхожда на всяка сутрин.",
    name: "Джесика Р.",
  } /* */,
  {
    quote: "Купих една кутия. Случайно поръчах още шест.",
    name: "Майк Т.",
  } /* */,
  {
    quote: "Тези развалиха всяка друга пекарна за мен.",
    name: "Алекс П.",
  } /* */,
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">Направено с любов ♥</span>
        <h1>
          Сутрините са<br />
          <em>по-добри</em><br />
          с мъфини.
        </h1>
        <p>
          Пухкави, ръчно изработени мъфини, изпечени в малки партиди. Създадени
          за сладките моменти в живота.
        </p>
        <div class="hero__actions">
          <a href="/muffins" class="btn btn-solid">Виж Мъфини</a>
          <a href="/muffins" class="btn btn-outline">Свържи се с нас</a>
        </div>
      </div>
      <div class="hero__media">
        <img src={heroImageUrl} alt={heroImageAlt} />
        <span class="hero__badge">Ръчно изработено<br />специално за теб</span>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features">
    <div class="wrap features__grid">
      {
        features.map((f) => (
          <div class="feature">
            <span
              class="feature__icon"
              aria-hidden="true"
              set:html={icons[f.icon]}
            />
            <h4>{f.title}</h4>
            <p>{f.copy}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FLAVORS -->
  <section class="flavors">
    <div class="wrap">
      <div class="section-heading">
        <span class="eyebrow">Пазарувай от нашите</span>
        <h2>Най-обичани вкусове</h2>
      </div>

      <div class="flavors__grid">
        {
          bestSellers.map((item) => (
            <article class="flavor-card">
              <a
                href={`/muffins/${item.muffinSlug}`}
                class="flavor-card__media"
              >
                <img src={item.muffinImageUrl} alt={item.muffinTitle} />
              </a>
              <h4>{item.muffinTitle}</h4>
              {item.fillingName && (
                <p class="flavor-card__filling">С {item.fillingName}</p>
              )}
              <a
                href={`/muffins/${item.muffinSlug}`}
                class="btn btn-solid btn-small"
              >
                Купи
              </a>
            </article>
          ))
        }
      </div>

      <div class="flavors__cta">
        <a href="/muffins" class="btn btn-outline">Виж всички вкусове</a>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="story">
    <div class="wrap story__grid">
      <div class="story__media">
        <img
          src="https://picsum.photos/seed/muffinbox/600/500"
          alt="Подаръчна кутия с различни мъфини, вързана с панделка"
        />
      </div>
      <div class="story__copy">
        <span class="eyebrow">Нашата история</span>
        <h2>Повече от мъфин,<br />това е <em>уют</em>.</h2>
        <p>
          Muffin Social беше създадена, за да внесе малко топлина в ежедневните
          моменти. Независимо дали е почерпка за вас самите или сладък начин да
          отпразнувате нечий празник, ние сме тук, за да направим всяка сутрин
          малко по-добра.
        </p>
        <a href="/about" class="btn btn-solid">Нашата история</a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS 
  <section class="testimonials">
    <div class="wrap">
      <div class="section-heading">
        <span class="eyebrow">Хората говорят</span>
      </div>
      <div class="testimonials__grid">
        {
          testimonials.map((t) => (
            <blockquote class="testimonial">
              <div class="testimonial__stars">★★★★★</div>
              <p>&ldquo;{t.quote}&rdquo;</p>
              <cite>— {t.name}</cite>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>
  -->

  <section class="gx-section">
    <div class="wrap">
      <div class="section-heading">
        <span class="eyebrow">Разгледайте</span>
        <h2>Нашата Галерия</h2>
      </div>

      <!-- Preview: 6 on desktop, 6 on tablet / large phones, 4 on small phones -->
      <div class="gx-preview">
        {
          previewImages.map((item, i) => (
            <button
              type="button"
              class:list={["gx-thumb", { "gx-thumb--extra": i >= 4 }]}
              data-gx-open={i}
              aria-label={`Отвори снимка ${i + 1}`}
            >
              <img src={item.imageUrl} alt={item.alt || ""} loading="lazy" />
            </button>
          ))
        }
      </div>

      {
        hasMore && (
          <div
            class:list={[
              "gx-cta",
              { "gx-cta--small-screens-only": !moreOnAllScreens },
            ]}
          >
            <button type="button" id="gxSeeAll" class="btn btn-outline">
              Виж всички снимки
            </button>
          </div>
        )
      }
    </div>

    <!-- ONE popup window: it shows either the grid of all photos or a single photo with prev/next -->
    <dialog id="gxDialog" class="gx-dialog" aria-label="Нашата Галерия">
      <div class="gx-dialog__header">
        <button type="button" id="gxBack" class="gx-back" hidden>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><polyline points="15 18 9 12 15 6"></polyline></svg
          >
          Всички снимки
        </button>
        <span class="gx-dialog__title" id="gxTitle">Нашата Галерия</span>
        <span class="gx-counter" id="gxCounter" hidden></span>
        <button type="button" id="gxClose" class="gx-close" aria-label="Затвори"
          >&times;</button
        >
      </div>

      <!-- View 1: all photos, scrollable inside the popup -->
      <div class="gx-all" id="gxAll">
        {
          gallery.map((item, i) => (
            <button
              type="button"
              class="gx-thumb"
              data-gx-open={i}
              aria-label={`Отвори снимка ${i + 1}`}
            >
              <img src={item.imageUrl} alt={item.alt || ""} loading="lazy" />
            </button>
          ))
        }
      </div>

      <!-- View 2: single photo with previous / next -->
      <div class="gx-viewer" id="gxViewer" hidden>
        <div class="gx-viewer__bg" id="gxBg" aria-hidden="true"></div>
        <div class="gx-stage" id="gxStage">
          <button
            type="button"
            id="gxPrev"
            class="gx-nav gx-nav--prev"
            aria-label="Предишна снимка"
          >
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><polyline points="15 18 9 12 15 6"></polyline></svg
            >
          </button>

          <div class="gx-stage__frame">
            <img id="gxImage" class="gx-stage__img" src="" alt="" />
          </div>

          <button
            type="button"
            id="gxNext"
            class="gx-nav gx-nav--next"
            aria-label="Следваща снимка"
          >
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><polyline points="9 18 15 12 9 6"></polyline></svg
            >
          </button>
        </div>

        <div class="gx-viewer__footer">
          <a id="gxCta" class="btn btn-solid" href="#">Виж мъфина</a>
        </div>
      </div>
    </dialog>
  </section>

  <script define:vars={{ gallery }}>
    const dialog = document.getElementById("gxDialog");
    const allView = document.getElementById("gxAll");
    const viewer = document.getElementById("gxViewer");
    const stage = document.getElementById("gxStage");
    const img = document.getElementById("gxImage");
    const bg = document.getElementById("gxBg");
    const cta = document.getElementById("gxCta");
    const prevBtn = document.getElementById("gxPrev");
    const nextBtn = document.getElementById("gxNext");
    const backBtn = document.getElementById("gxBack");
    const closeBtn = document.getElementById("gxClose");
    const title = document.getElementById("gxTitle");
    const counter = document.getElementById("gxCounter");
    const seeAllBtn = document.getElementById("gxSeeAll");

    let current = 0;

    function preload(i) {
      if (gallery[i]) new Image().src = gallery[i].imageUrl;
    }

    function showPhoto(index) {
      current = index;
      const item = gallery[current];
      img.src = item.imageUrl;
      img.alt = item.alt || "";
      bg.style.backgroundImage = `url("${item.imageUrl}")`;
      counter.textContent = `${current + 1} / ${gallery.length}`;

      if (item.muffinSlug) {
        cta.href = `/muffins/${item.muffinSlug}`;
        cta.style.display = "";
      } else {
        cta.style.display = "none";
      }

      prevBtn.style.visibility = current > 0 ? "visible" : "hidden";
      nextBtn.style.visibility =
        current < gallery.length - 1 ? "visible" : "hidden";

      preload(current - 1);
      preload(current + 1);
    }

    function setView(view) {
      const isViewer = view === "viewer";
      viewer.hidden = !isViewer;
      allView.hidden = isViewer;
      backBtn.hidden = !isViewer;
      title.hidden = isViewer;
      counter.hidden = !isViewer;
    }

    function openDialog(view, index) {
      if (!dialog.open) {
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
      }
      setView(view);
      if (view === "viewer") showPhoto(index);
    }

    function goPrev() {
      if (current > 0) showPhoto(current - 1);
    }
    function goNext() {
      if (current < gallery.length - 1) showPhoto(current + 1);
    }

    // Any thumbnail (on the page or inside the popup) opens the single-photo view
    document.querySelectorAll("[data-gx-open]").forEach((btn) => {
      btn.addEventListener("click", () =>
        openDialog("viewer", Number(btn.dataset.gxOpen)),
      );
    });

    seeAllBtn?.addEventListener("click", () => {
      openDialog("all");
      allView.scrollTop = 0;
    });

    backBtn.addEventListener("click", () => setView("all"));
    prevBtn.addEventListener("click", goPrev);
    nextBtn.addEventListener("click", goNext);
    closeBtn.addEventListener("click", () => dialog.close());

    // Click on the dark backdrop closes the popup
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Restore page scrolling however the popup was closed (X, Esc, backdrop)
    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });

    document.addEventListener("keydown", (e) => {
      if (!dialog.open || viewer.hidden) return;
      if (e.key === "ArrowLeft") goPrev();
      if (e.key === "ArrowRight") goNext();
    });

    // Swipe on touch screens
    let touchStartX = 0;
    stage.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.touches[0].clientX;
      },
      { passive: true },
    );
    stage.addEventListener(
      "touchend",
      (e) => {
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(deltaX) > 50) {
          deltaX < 0 ? goNext() : goPrev();
        }
      },
      { passive: true },
    );
  </script>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    padding-top: 64px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
  }
  .hero__copy h1 {
    font-size: 3.4rem;
    line-height: 1.08;
    margin: 6px 0 22px;
  }
  .hero__copy h1 em {
    font-style: italic;
    color: var(--color-pink);
  }
  .hero__copy p {
    color: var(--color-text-soft);
    max-width: 40ch;
    margin-bottom: 30px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero__media {
    position: relative;
  }
  .hero__media img {
    border-radius: 16px;
    width: 100%;
    object-fit: cover;
  }
  .hero__badge {
    position: absolute;
    bottom: -18px;
    right: -18px;
    background: var(--color-pink);
    color: #fff;
    width: 108px;
    height: 108px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    box-shadow: 0 8px 24px rgba(232, 115, 125, 0.35);
  }

  /* FEATURES */
  .features {
    padding: 56px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .features__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
    text-align: center;
  }
  .feature__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;      
    height: 46px;     
    margin: 0 auto 12px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    color: var(--color-dark);
  }
  .feature__icon svg {
    width: 16px;      /* was 18px */
    height: 16px;     /* was 18px */
  }
  .feature h4 {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .feature p {
    font-size: 0.82rem;
    color: var(--color-text-soft);
    margin: 0;
  }

  /* SECTION HEADING */
  .section-heading {
    text-align: center;
    margin-bottom: 44px;
  }
  .section-heading h2 {
    font-size: 2.1rem;
  }
  .community__handle {
    color: var(--color-text-soft);
    margin-top: 4px;
  }

  /* FLAVORS */
  .flavors__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
  }
  .flavor-card {
    background: #fff;
    border-radius: 14px;
    padding: 14px;
    text-align: center;
  }
  .flavor-card__media {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    margin-bottom: 12px;
  }
  .flavor-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .flavor-card h4 {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .btn-small {
    padding: 8px 18px;
    font-size: 0.7rem;
  }
  .flavors__cta {
    text-align: center;
    margin-top: 36px;
  }

  /* STORY */
  .story {
    background: var(--color-bg-alt);
  }
  .story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .story__media img {
    border-radius: 16px;
    width: 100%;
  }
  .story__copy h2 {
    font-size: 2rem;
    margin: 6px 0 20px;
  }
  .story__copy h2 em {
    font-style: italic;
    color: var(--color-pink);
  }
  .story__copy p {
    color: var(--color-text-soft);
    max-width: 46ch;
    margin-bottom: 26px;
  }

  /* TESTIMONIALS */
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .testimonial {
    margin: 0;
    background: #fff;
    border-radius: 14px;
    padding: 28px 24px;
    text-align: center;
  }
  .testimonial__stars {
    color: var(--color-gold);
    letter-spacing: 2px;
    margin-bottom: 12px;
  }
  .testimonial p {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-dark);
    margin-bottom: 14px;
  }
  .testimonial cite {
    font-size: 0.8rem;
    color: var(--color-text-soft);
    font-style: normal;
  }

  /* COMMUNITY */
  .community__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
    margin-bottom: 8px;
  }
  .community__item {
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
  }
  .community__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 40px;
    }
    .hero__grid,
    .story__grid {
      grid-template-columns: 1fr;
    }
    .hero__media {
      overflow: visible;
    }
    .hero__badge {
      width: 88px;
      height: 88px;
      font-size: 0.68rem;
      bottom: -14px;
      right: 8px;
    }
