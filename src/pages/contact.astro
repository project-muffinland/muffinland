---
// src/pages/contact.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";

// TODO: paste your Web3Forms access key (get it free at web3forms.com).
// It's safe to be public - it only lets people send mail to your address.
const WEB3FORMS_KEY = "YOUR_ACCESS_KEY_HERE";

// TODO: replace these placeholders with your real details
const contact = {
  email: "hello@muffinland.bg",
  phone: "+359 88 888 8888",
  hours: "Всеки ден",
  area: "Доставяме само в София",
};

const icons = {
  mail: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`,
  phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>`,
  clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>`,
  truck: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>`,
};

const details = [
  { icon: "mail", label: "Имейл", value: contact.email, href: `mailto:${contact.email}` },
  { icon: "phone", label: "Телефон", value: contact.phone, href: `tel:${contact.phone.replace(/\s/g, "")}` },
  { icon: "clock", label: "Работно време", value: contact.hours },
  { icon: "truck", label: "Доставка", value: contact.area },
];
---

<BaseLayout
  title="Контакти — Muffinland"
  description="Имаш въпрос или искаш персонализирана поръчка? Пиши ни и ще ти отговорим възможно най-скоро."
>
  <!-- HEADER -->
  <section class="contact-head">
    <div class="wrap">
      <span class="eyebrow">Контакти</span>
      <h1>Здравей! С какво можем да помогнем?</h1>
      <p>
        Въпрос за поръчка, идея за повод или нещо специално? Остави ни съобщение
        и ще ти отговорим възможно най-скоро.
      </p>
    </div>
  </section>

  <!-- FORM + DETAILS -->
  <section class="contact-main">
    <div class="wrap contact-main__grid">
      <div class="contact-card">
        <h2>Изпрати запитване</h2>

        <form id="contactForm" class="cform">
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="Ново запитване от Muffinland" />
          <input type="hidden" name="from_name" value="Muffinland уебсайт" />

          <div class="field">
            <label for="cf-name">Име</label>
            <input
              id="cf-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Как се казваш?"
              required
              minlength="2"
              maxlength="100"
            />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="cf-email">Имейл</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@example.com"
                required
                maxlength="150"
              />
            </div>
            <div class="field">
              <label for="cf-phone">Телефон</label>
              <input
                id="cf-phone"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                placeholder="+359 88 888 8888"
                required
                pattern="^(\+359|00359|0)[\s\-]?[1-9][\d\s\-]{7,11}$"
                title="Въведи български номер, например 0888 123 456 или +359 888 123 456"
              />
            </div>
          </div>

          <div class="field">
            <label for="cf-question">Въпрос</label>
            <textarea
              id="cf-question"
              name="question"
              rows="6"
              placeholder="Разкажи ни с какво можем да помогнем..."
              required
              minlength="5"
              maxlength="2000"
            ></textarea>
          </div>

          <!-- Spam trap (Web3Forms): hidden from people, bots tend to tick it -->
          <input
            type="checkbox"
            name="botcheck"
            class="cform__hp"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <button type="submit" class="btn btn-solid cform__submit" id="cfSubmit">
            Изпрати
          </button>

          <p class="cform__status" id="cfStatus" role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="contact-info">
        <h2>Свържи се директно</h2>
        <ul>
          {
            details.map((d) => (
              <li>
                <span class="contact-info__icon" aria-hidden="true" set:html={icons[d.icon as keyof typeof icons]} />
                <div>
                  <span class="contact-info__label">{d.label}</span>
                  {d.href ? <a href={d.href}>{d.value}</a> : <span class="contact-info__value">{d.value}</span>}
                </div>
              </li>
            ))
          }
        </ul>
        <p class="contact-info__note">
          За големи поръчки ни пиши поне 5–7 дни
          предварително. Благодарим
        </p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ alt />

  <script>
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    const statusEl = document.getElementById("cfStatus") as HTMLElement | null;
    const submitBtn = document.getElementById("cfSubmit") as HTMLButtonElement | null;

    function setStatus(message: string, type: "success" | "error" | "") {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.dataset.type = type;
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!submitBtn || !form.reportValidity()) return;

      const data = Object.fromEntries(new FormData(form).entries());

      submitBtn.disabled = true;
      submitBtn.textContent = "Изпращане...";
      setStatus("", "");

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));

        if (!res.ok || json?.success === false) {
          throw new Error("Не успяхме да изпратим запитването. Опитай отново.");
        }

        form.reset();
        setStatus("Благодарим! Получихме запитването ти и ще ти отговорим скоро.", "success");
      } catch (err) {
        setStatus(
          err instanceof Error ? err.message : "Нещо се обърка. Опитай отново.",
          "error",
        );
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Изпрати";
      }
    });
  </script>
</BaseLayout>

<style>
  /* HEADER */
  .contact-head {
    padding: 72px 0 24px;
    text-align: center;
  }
  .contact-head h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.15;
    max-width: 18ch;
    margin: 6px auto 16px;
  }
  .contact-head p {
    color: var(--color-text-soft);
    max-width: 52ch;
    margin: 0 auto;
  }

  /* MAIN GRID */
  .contact-main {
    padding-top: 40px;
  }
  .contact-main__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px;
    align-items: start;
  }

  /* FORM CARD */
  .contact-card {
    background: #fffaf7;
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    padding: 36px;
  }
  .contact-card h2,
  .contact-info h2 {
    font-size: 1.6rem;
    margin-bottom: 24px;
  }

  .cform {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .field label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-dark);
  }
  .field input,
  .field textarea {
    width: 100%;
    font: inherit;
    color: var(--color-text);
    background: #fff;
    border: 1.5px solid var(--color-border);
    border-radius: 14px;
    padding: 13px 16px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .field textarea {
    resize: vertical;
    min-height: 140px;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #a39a92;
  }
  .field input:hover,
  .field textarea:hover {
    border-color: var(--color-pink-light);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-pink);
    box-shadow: 0 0 0 4px rgba(232, 115, 125, 0.15);
  }
  /* only flag invalid fields after the person has typed in them */
  .field input:not(:placeholder-shown):invalid,
  .field textarea:not(:placeholder-shown):invalid {
    border-color: var(--color-pink-dark);
  }

  .cform__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cform__submit {
    align-self: flex-start;
    min-width: 180px;
  }
  .cform__submit:disabled {
    opacity: 0.7;
    cursor: wait;
    transform: none;
  }

  .cform__status {
    margin: 0;
    min-height: 1.4em;
    font-size: 0.95rem;
  }
  .cform__status[data-type="success"] {
    color: #2f7a4f;
  }
  .cform__status[data-type="error"] {
    color: var(--color-pink-dark);
  }

  /* INFO PANEL */
  .contact-info {
    background: var(--color-dark);
    color: #fff;
    border-radius: 20px;
    padding: 36px;
  }
  .contact-info h2 {
    color: #fff;
  }
  .contact-info ul {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-info li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .contact-info__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-pink-light);
  }
  .contact-info__icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .contact-info__label {
    display: block;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 2px;
  }
  .contact-info a,
  .contact-info__value {
    font-weight: 500;
    color: #fff;
    overflow-wrap: anywhere;
  }
  .contact-info a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-info__note {
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 900px) {
    .contact-head {
      padding: 44px 0 8px;
    }
    .contact-main {
      padding-top: 24px;
    }
    .contact-main__grid {
      grid-template-columns: 1fr;
    }
    .contact-card,
    .contact-info {
      padding: 26px 20px;
    }
  }

  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: 1fr;
    }
    .cform__submit {
      align-self: stretch;
    }
  }
</style>
