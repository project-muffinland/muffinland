---
// src/layouts/BaseLayout.astro
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Muffin Social — Мъфини. По всяко време. Навсякъде.", /*[cite: 4] */
  description = "Ръчно изработени мъфини, изпечени в малки партиди с качествени съставки. Идеални за рождени дни, подаръци или просто така.", /*[cite: 4] */
} = Astro.props;
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Fraunces:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Jost:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Safety net: stops any stray element (badges, absolutely-positioned
     decorations, fixed-width inputs, etc.) from creating horizontal
     scroll on mobile. Doesn't fix the source, just contains it. */
  html,
  body {
    max-width: 100%;
    overflow-x: hidden;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
</style>